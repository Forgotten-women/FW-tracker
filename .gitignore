# Dependencies
node_modules/
backend/node_modules/

# Database migrations are code and must be tracked
!backend/src/db/**/*.sql
!backend/src/db/*.sql
# Environment & secrets
.env
.env.*
!.env.example
secrets.h
firmware/**/secrets.h
backend/config/office.local.json

# Runtime data — contains employee PII (names, MACs, movement logs).
# Must never be committed. See backend/data/README.md
backend/data/*.json
backend/data/*.db
backend/data/*.db-wal
backend/data/*.db-shm
desktop/*.db
desktop/*.db-wal
desktop/*.db-shm
backend/data/backups/
# Uploaded employee documents - PII, never committed and never web-served
backend/data/documents/
# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
*.png

# Build output
build/
dist/
*.md