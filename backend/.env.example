# Copy to .env (gitignored) and fill in.

PORT=5000

# Origin allowed to call the API from a browser. The dashboard's own origin.
# Comma-separate for multiple. Do NOT use "*" - it lets any page on the LAN
# call the admin API from a logged-in browser.
CORS_ORIGIN=http://localhost:5000

# Admin API key, used by the dashboard and for employee management.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_KEY=

# HMAC shared secrets for hardware sensors, one per sensor id.
# Must match SENSOR_SECRET in the ESP8266's secrets.h
# Format: SENSOR_SECRET_<SENSOR_ID with - and . replaced by _>
SENSOR_SECRET_esp_main_01=

# Only set this if a reverse proxy sits in front of the server, and set it to
# that proxy's address (e.g. 127.0.0.1) rather than "true". Presence location is
# verified from the request source IP, so trusting X-Forwarded-For from anyone
# would let a client claim an office IP with a header.
# TRUST_PROXY=
