// ==========================================================================
// secrets.h  —  COPY THIS FILE TO `secrets.h` AND FILL IN YOUR VALUES.
//
// `secrets.h` is gitignored and MUST NEVER be committed.
// The previous firmware hardcoded the office Wi-Fi password directly in
// Flash_code.cpp, so that password is permanently in this repo's git history
// and must be treated as public. Rotate it before relying on this file.
// ==========================================================================
#pragma once

// --- Office Wi-Fi ---
#define WIFI_SSID       "YourOfficeSSID"
#define WIFI_PASSWORD   "YourOfficePassword"

// --- Backend ---
#define BACKEND_HOST    "192.168.18.68"
#define BACKEND_PORT    5000

// --- Sensor identity & authentication ---
// SENSOR_ID identifies this physical device to the backend.
// SENSOR_SECRET is the HMAC-SHA256 shared secret used to sign every report.
// Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
// The same value must be set as SENSOR_SECRET_<SENSOR_ID> in the backend .env
#define SENSOR_ID       "esp-main-01"
#define SENSOR_SECRET   "replace-with-32-byte-hex-secret"
