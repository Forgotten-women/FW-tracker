{
  "name": "office-tracker-desktop",
  "version": "1.0.0",
  "description": "Office Tracker - Cross-Platform Workstation Presence & Desktop Agent",
  "private": true,
  "scripts": {
    "start": "node run-agent.js",
    "dev": "tauri dev",
    "build": "tauri build",
    "package:win": "npx -y @yao-pkg/pkg run-agent.js --targets node18-win-x64 --output office-tracker-agent.exe",
    "package:mac": "npx -y @yao-pkg/pkg run-agent.js --targets node18-macos-x64,node18-macos-arm64 --output office-tracker-agent-mac"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^1.5.14"
  }
}
